// Weapon Option File V1.1	Old stuff removed, slots + granade types added
// Weapon Option File V1.0	Base version
option weapon 0
{
	weight		20	// equipment weight (kg)
	magazineSize	0	// magazine size
	bullets		6
	shootsPerMin	0.5	// maximum fire rate
	type		missile	// can be: bullet, granade, missile, homingMissile
	gameRadius 0.00
	timeToExplode	0	// 0 = immediately; > 0 after a delay; < 0 sticks + countdown
	subType		101	// index within the weapon category
	range		2 10	// min/max explosion blast radius
	damage		0 0.5	// min/max explosion damage
	speed		100	// initial projectile speed
}
